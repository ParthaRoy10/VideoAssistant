# Required: Mistral API key (summaries, extraction, RAG answers)
MISTRAL_API_KEY=your_mistral_api_key

# Only needed for Hinglish audio (Sarvam AI speech-to-text with translation)
SARVAM_API_KEY=your_sarvam_api_key

# Optional: Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Optional: Sarvam model name
SARVAM_STT_MODEL=saaras:v2.5
